scenes/zones/rustwash_basin/**/*.jpg filter=lfs diff=lfs merge=lfs -text
scenes/zones/rustwash_basin/**/*.JPG filter=lfs diff=lfs merge=lfs -text
scenes/zones/rustwash_basin/**/*.png filter=lfs diff=lfs merge=lfs -text
scenes/zones/rustwash_basin/**/*.PNG filter=lfs diff=lfs merge=lfs -text
scenes/zones/rustwash_basin/**/*.res filter=lfs diff=lfs merge=lfs -text
