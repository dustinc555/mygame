[gd_resource type="Resource" script_class="ContainerStockTable" format=3]

[ext_resource type="Script" path="res://features/settlements/resources/furnishing/container_stock_table.gd" id="1_table"]
[ext_resource type="Script" path="res://features/settlements/resources/furnishing/container_stock_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://features/inventory/resources/items/hoe.tres" id="3_hoe"]
[ext_resource type="Resource" path="res://features/inventory/resources/items/scythe.tres" id="4_scythe"]
