[resource]
script = ExtResource("1")
actor_id = "tavin_rook"
member_name = "Tavin Rook"
backstory = "Tavin Rook is a salvage mechanic who repairs pumps and other worn machinery with recovered parts. He is patient with broken machines, impatient with people, and meticulous about debts, including his own.

A merchant hired him to repair a water pump, then refused to pay. Tavin returned at night, removed the regulator he had fitted, and sold it. He calls that taking back his property. The pump also supplied several households. He knew they depended on it and took the part anyway.

He is being held for theft and sabotage. The merchant exaggerates the damage; Tavin's account leaves out the people who went without water. Neither version is entirely false. He is a capable craftsperson whose stubbornness became somebody else's problem, not a secret assassin or an innocent waiting to be vindicated.

He notices defects before introductions. On meeting somebody at his cell: 'Lift the gate before you try the lock. Hinge is sagging. You'll bend your pick.' Freeing him does not automatically earn his loyalty or recruit him."
