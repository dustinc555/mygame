[gd_resource type="Resource" script_class="AiUtilityProfile" load_steps=6 format=3]

[ext_resource type="Script" path="res://features/ai/resources/ai_utility_profile.gd" id="1_profile"]
[ext_resource type="Resource" path="res://features/ai/resources/utility_goals/self_defense.tres" id="2_self_defense"]
[ext_resource type="Resource" path="res://features/ai/resources/utility_goals/heal.tres" id="3_heal"]
[ext_resource type="Resource" path="res://features/ai/resources/utility_goals/assigned_work.tres" id="4_assigned_work"]
[ext_resource type="Resource" path="res://features/ai/resources/utility_goals/wander.tres" id="5_wander"]

[resource]
script = ExtResource("1_profile")
profile_id = "default_humanoid"
display_name = "Default Humanoid"
fallback_goal_id = &"wander"
goals = Array[Resource]([ExtResource("2_self_defense"), ExtResource("3_heal"), ExtResource("4_assigned_work"), ExtResource("5_wander")])
