[gd_resource type="Resource" script_class="FactionLawProfile" format=3]

[ext_resource type="Script" path="res://features/factions/resources/faction_law_profile.gd" id="1_profile"]

[resource]
script = ExtResource("1_profile")
profile_id = "settler_common_law"
display_name = "Settler Common Law"
trespass_warning_interval_seconds = 3.0
trespass_warnings_before_alarm = 2
trespass_notice_radius = 18.0
trespass_escalation = "settlement_alarm"
petty_theft_value_threshold = 0
theft_response = "settlement_alarm"
assault_response = "settlement_alarm"
murder_response = "settlement_alarm"
operator_notes = "Stable default: no killing, stealing, or trespassing. Repeat trespass and crimes escalate to settlement response."
